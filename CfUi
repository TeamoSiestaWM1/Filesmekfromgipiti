    btn.Size = UDim2.new(0, 165, 0, 28)
    btn.BackgroundColor3 = color
    btn.Text = btnName
    btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    btn.Font = Enum.Font.SourceSans
    btn.TextSize = 13
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(callback)
end

