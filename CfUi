        Title = "Atlas Manager",
        Text = msg,
        Duration = 3
    })
end

----------------------------------------------------------------
-- LOGIC TẢI VÀ GHI FILE
----------------------------------------------------------------
local function applyConfigFromRaw(cfgName, url)
    if not url or url == "" then 
        ShowNotification("⚠️ Link '" .. cfgName .. "' đang trống!")
        return 
    end

    ShowNotification("📡 Đang tải config...")
    
    local success, content = pcall(function()
        -- Gửi yêu cầu với Token bảo mật qua Header
        return game:HttpGetAsync(url, true, {
            ["Authorization"] = "token " .. githubToken
        })
    end)

    if success and content and content:sub(1,1) == "{" then
        if not isfolder("atlas") then makefolder("atlas") end
        
        -- File pointer theo yêu cầu
        writefile("atlas-" .. playerName .. ".json", playerName .. ".json")
        -- File nội dung JSON thực tế
        writefile("atlas/" .. playerName .. ".json", content)
        
        ShowNotification("✅ Đã nạp thành công: " .. cfgName)
    else
        ShowNotification("❌ Lỗi tải! Kiểm tra lại Token hoặc Link.")
        warn("Lỗi chi tiết: " .. tostring(content))
    end
end

