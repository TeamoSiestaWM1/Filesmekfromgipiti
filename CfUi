local function applyConfig(fileName, rawUrl)
    ShowNotification("📡 Đang nạp: " .. fileName)
    
    -- Fix lỗi cast bool to HttpRequestType bằng cách dùng request dictionary
    local success, response = pcall(function()
        return request({
            Url = rawUrl,
            Method = "GET",
            Headers = {
                ["Authorization"] = "token " .. githubToken
            }
        })
    end)

    if success and response.Success then
        local content = response.Body
        if not isfolder("atlas") then makefolder("atlas") end
        writefile("atlas-" .. playerName .. ".json", playerName .. ".json")
        writefile("atlas/" .. playerName .. ".json", content)
        ShowNotification("✅ Thành công: " .. fileName)
    else
        ShowNotification("❌ Lỗi tải file!")
    end
end

-- Tự động lấy danh sách file qua API
local apiUrl = string.format("https://api.github.com/repos/%s/%s/contents?ref=%s", userName, repoName, branch)
task.spawn(function()
    local success, response = pcall(function()
        return request({
            Url = apiUrl,
            Method = "GET",
            Headers = {
                ["Authorization"] = "token " .. githubToken
            }
        })
    end)

    if success and response.Success then
        local fileList = game:GetService("HttpService"):JSONDecode(response.Body)
        for _, file in ipairs(fileList) do
            if file.type == "file" and file.name:match("%.json$") then
                local displayName = file.name:gsub("%.json$", "")
                createButton(displayName, Color3.fromRGB(45, 45, 45), function()
                    applyConfig(displayName, file.download_url)
                end)
            end
        end
        title.Text = "ATLAS (Closed)"
    else
        title.Text = "ATLAS (API Error)"
    end
end)

